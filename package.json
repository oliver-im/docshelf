{
  "name": "obsidian-docshelf",
  "version": "0.1.0",
  "private": true,
  "description": "A searchable, read-only shelf of external Markdown and HTML documents in Obsidian.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:obsidian": "node scripts/test-obsidian.mjs",
    "validate:shelf": "tsx scripts/validate-shelf.ts",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/markdown-it": "^14.1.2",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.1",
    "playwright-core": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.14",
    "markdown-it": "^14.1.0",
    "minisearch": "^7.1.2",
    "parse5": "^7.3.0"
  }
}
