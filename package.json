{
  "name": "docshelf",
  "type": "module",
  "version": "0.0.1",
  "description": "A searchable shelf for local artifacts and browser-imported public documents.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "sync": "node scripts/sync-artifacts.mjs",
    "predev": "npm run sync",
    "dev": "astro dev",
    "prebuild": "npm run sync",
    "build": "astro build",
    "precheck": "npm run sync",
    "check": "astro check",
    "prepreview": "npm run sync",
    "preview": "astro preview",
    "watch": "node scripts/watch.mjs",
    "setup": "node scripts/setup.mjs",
    "daemon:install": "node scripts/launchd.mjs install",
    "daemon:status": "node scripts/launchd.mjs status",
    "daemon:uninstall": "node scripts/launchd.mjs uninstall",
    "links": "node scripts/links.mjs",
    "test:all": "npm test && npm run test --workspaces",
    "check:all": "npm run check --workspace @docshelf/core && npm run check && npm run check --workspace obsidian-docshelf",
    "build:all": "npm run build --workspace @docshelf/core && npm run build && npm run build --workspace obsidian-docshelf",
    "package:obsidian": "npm run package --workspace obsidian-docshelf"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/starlight": "^0.41.10",
    "astro": "^7.2.9",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "pagefind": "^1.5.2",
    "parse5": "^7.3.0",
    "@docshelf/core": "0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "packages/core",
    "packages/obsidian"
  ]
}
