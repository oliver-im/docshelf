{
  "name": "docshelf",
  "type": "module",
  "version": "0.1.0",
  "description": "A searchable shelf for local artifacts and browser-imported public documents.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "sync": "node scripts/sync-artifacts.mjs",
    "predev": "npm run sync",
    "dev": "astro dev",
    "build": "npm run build --workspace @docshelf/core && npm run build:web && npm run build:obsidian",
    "precheck": "npm run sync",
    "check": "astro check",
    "prepreview": "npm run sync",
    "preview": "astro preview",
    "watch": "node scripts/watch.mjs",
    "setup": "node scripts/setup.mjs",
    "daemon:install": "node scripts/launchd.mjs install",
    "daemon:status": "node scripts/launchd.mjs status",
    "daemon:uninstall": "node scripts/launchd.mjs uninstall",
    "links": "node scripts/links.mjs",
    "test:all": "npm test && npm run test --workspaces",
    "check:all": "npm run lint && npm run check --workspace @docshelf/core && npm run check && npm run check --workspace obsidian-docshelf",
    "build:all": "npm run build",
    "package:obsidian": "npm run package --workspace obsidian-docshelf",
    "sync:obsidian-metadata": "node packages/obsidian/scripts/release-metadata.mjs --sync",
    "prebuild:web": "npm run sync",
    "build:web": "astro build",
    "build:obsidian": "npm run build --workspace obsidian-docshelf && node scripts/stage-obsidian.mjs",
    "lint": "eslint packages/obsidian/src \"public/*.js\" \"src/lib/*.{ts,js}\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/starlight": "^0.41.10",
    "@docshelf/core": "*",
    "astro": "^7.2.9",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "pagefind": "^1.5.2",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "playwright-core": "^1.55.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "workspaces": [
    "packages/core",
    "packages/obsidian"
  ]
}
