---
import manifest from '../generated/artifacts.json';

interface Artifact {
  project: string;
  route: string;
  title: string;
  description: string;
}

const artifacts = manifest.artifacts as Artifact[];
const projects = Map.groupBy(artifacts, (artifact) => artifact.project);
---

{artifacts.length === 0 ? (
  <p>No artifacts are registered.</p>
) : Array.from(projects, ([project, projectArtifacts]) => (
  <section>
    <h2>{project}</h2>
    <ul>
      {projectArtifacts.map((artifact) => (
        <li>
          <a href={`/artifacts/${artifact.route}`}>{artifact.title}</a>
          {' — '}{artifact.description}
        </li>
      ))}
    </ul>
  </section>
))}
