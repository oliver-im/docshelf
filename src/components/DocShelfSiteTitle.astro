---
const basePath = import.meta.env.BASE_URL;
const showSidebarToggle = [basePath, `${basePath}index.html`].includes(Astro.url.pathname);
---

{
  showSidebarToggle && (
    <div class="docshelf-header-controls">
      <button
        class="sidebar-toggle print:hidden"
        type="button"
        data-docshelf-sidebar-toggle
        aria-controls="starlight__sidebar"
        aria-expanded="true"
        aria-label="Hide navigation"
        title="Toggle navigation (⌘B or Ctrl+B)"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <path d="M9 4v16" />
        </svg>
      </button>
      <button
        class="import-artifact-button print:hidden"
        type="button"
        data-docshelf-import-open
        aria-haspopup="dialog"
        aria-label="Add a document"
        title="Add a document"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M12 5v14M5 12h14" />
        </svg>
      </button>
    </div>
  )
}

<script>
  const sidebarToggle = document.querySelector<HTMLButtonElement>(
    '[data-docshelf-sidebar-toggle]',
  );

  if (sidebarToggle && sidebarToggle.dataset.initialized !== 'true') {
    sidebarToggle.dataset.initialized = 'true';
    initializeSidebarToggle(sidebarToggle);
  }

  function initializeSidebarToggle(button: HTMLButtonElement) {
    const root = document.documentElement;
    const sidebar = document.getElementById('starlight__sidebar');
    const desktop = window.matchMedia('(min-width: 50rem)');

    if (!sidebar) return;

    const resizer = document.createElement('div');
    resizer.className = 'docshelf-sidebar-resizer';
    resizer.dataset.docshelfSidebarResizer = '';
    resizer.setAttribute('role', 'separator');
    resizer.setAttribute('aria-label', 'Resize navigation');
    resizer.setAttribute('aria-orientation', 'vertical');
    resizer.tabIndex = 0;
    resizer.title = 'Drag to resize navigation';
    document.body.append(resizer);

    const defaultWidth = sidebar.getBoundingClientRect().width;
    const savedWidth = Number(readPreference('docshelf:sidebar-width'));
    let currentWidth = Number.isFinite(savedWidth) && savedWidth > 0 ? savedWidth : defaultWidth;
    let activePointer: number | undefined;

    button.addEventListener('click', () => {
      setSidebar(root.dataset.docshelfLeft === 'hidden');
    });

    resizer.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || !desktop.matches || root.dataset.docshelfLeft === 'hidden') return;

      event.preventDefault();
      activePointer = event.pointerId;
      resizer.setPointerCapture(event.pointerId);
      resizer.dataset.resizing = 'true';
      document.body.dataset.docshelfResizing = 'true';
      resizeFromPointer(event.clientX);
    });

    resizer.addEventListener('pointermove', (event) => {
      if (event.pointerId !== activePointer) return;
      resizeFromPointer(event.clientX);
    });

    resizer.addEventListener('pointerup', finishPointerResize);
    resizer.addEventListener('pointercancel', finishPointerResize);

    resizer.addEventListener('keydown', (event) => {
      const direction = getComputedStyle(root).direction === 'rtl' ? -1 : 1;
      let nextWidth: number | undefined;

      if (event.key === 'ArrowLeft') nextWidth = currentWidth - 16 * direction;
      if (event.key === 'ArrowRight') nextWidth = currentWidth + 16 * direction;
      if (event.key === 'Home') nextWidth = sidebarWidthRange().min;
      if (event.key === 'End') nextWidth = sidebarWidthRange().max;
      if (nextWidth === undefined) return;

      event.preventDefault();
      setSidebarWidth(nextWidth);
    });

    window.addEventListener('resize', () => setSidebarWidth(currentWidth, false));

    window.addEventListener('keydown', (event) => {
      if (
        isEditableTarget(event.target) ||
        !(event.metaKey || event.ctrlKey) ||
        event.altKey ||
        event.shiftKey ||
        event.key.toLowerCase() !== 'b' ||
        !desktop.matches
      ) {
        return;
      }

      event.preventDefault();
      setSidebar(root.dataset.docshelfLeft === 'hidden');
    });

    setSidebarWidth(currentWidth, false);
    setSidebar(readPreference('docshelf:left-panel') !== 'hidden', false);

    function resizeFromPointer(pointerX: number) {
      const width = getComputedStyle(root).direction === 'rtl' ? window.innerWidth - pointerX : pointerX;
      setSidebarWidth(width, false);
    }

    function finishPointerResize(event: PointerEvent) {
      if (event.pointerId !== activePointer) return;
      if (resizer.hasPointerCapture(event.pointerId)) resizer.releasePointerCapture(event.pointerId);
      activePointer = undefined;
      delete resizer.dataset.resizing;
      delete document.body.dataset.docshelfResizing;
      writePreference('docshelf:sidebar-width', String(currentWidth));
    }

    function setSidebarWidth(width: number, persist = true) {
      const range = sidebarWidthRange();
      currentWidth = Math.round(Math.min(range.max, Math.max(range.min, width)));
      root.style.setProperty('--sl-sidebar-width', `${currentWidth}px`);
      resizer.setAttribute('aria-valuemin', String(range.min));
      resizer.setAttribute('aria-valuemax', String(range.max));
      resizer.setAttribute('aria-valuenow', String(currentWidth));
      if (persist) writePreference('docshelf:sidebar-width', String(currentWidth));
    }

    function sidebarWidthRange() {
      return {
        min: 192,
        max: Math.round(Math.min(576, window.innerWidth / 2)),
      };
    }

    function setSidebar(visible: boolean, persist = true) {
      root.dataset.docshelfLeft = visible ? 'visible' : 'hidden';
      button.setAttribute('aria-expanded', String(visible));
      button.setAttribute('aria-label', visible ? 'Hide navigation' : 'Show navigation');
      if (persist) writePreference('docshelf:left-panel', visible ? 'visible' : 'hidden');
    }
  }

  function isEditableTarget(target: EventTarget | null) {
    return (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      (target instanceof HTMLElement && target.isContentEditable)
    );
  }

  function readPreference(key: string) {
    try {
      return window.localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function writePreference(key: string, value: string) {
    try {
      window.localStorage.setItem(key, value);
    } catch {
      // The navigation remains usable when storage is unavailable.
    }
  }
</script>

<style>
  .docshelf-header-controls {
    display: flex;
    min-width: 0;
    align-items: center;
  }

  .sidebar-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .import-artifact-button {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .sidebar-toggle:hover {
    border-color: var(--sl-color-hairline-light);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
  }

  .import-artifact-button:hover {
    border-color: var(--sl-color-hairline-light);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
  }

  .sidebar-toggle:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .import-artifact-button:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .sidebar-toggle[aria-expanded='false'] {
    color: var(--sl-color-gray-4);
  }

  .sidebar-toggle svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .import-artifact-button svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.75;
  }

  @media (min-width: 50rem) {
    .sidebar-toggle {
      display: inline-flex;
    }

    :global(html[data-docshelf-left='hidden']) {
      --sl-content-inline-start: 0rem;
    }

    :global(html[data-docshelf-left='hidden'] nav.sidebar) {
      display: none;
    }

    :global(html[data-docshelf-left='visible'] .docshelf-sidebar-resizer) {
      display: block;
    }

    :global(.docshelf-sidebar-resizer) {
      position: fixed;
      z-index: 6;
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: calc(var(--sl-sidebar-width) - 0.25rem);
      display: none;
      width: 0.5rem;
      cursor: col-resize;
      touch-action: none;
    }

    :global(.docshelf-sidebar-resizer::after) {
      position: absolute;
      inset-block: 0;
      inset-inline-start: calc(50% - 0.5px);
      width: 1px;
      background: transparent;
      content: '';
      transition:
        width 160ms ease,
        background-color 160ms ease;
    }

    :global(.docshelf-sidebar-resizer:hover::after),
    :global(.docshelf-sidebar-resizer:focus-visible::after),
    :global(.docshelf-sidebar-resizer[data-resizing='true']::after) {
      width: 2px;
      background: var(--sl-color-accent);
    }

    :global(.docshelf-sidebar-resizer:focus-visible) {
      outline: none;
    }

    :global(body[data-docshelf-resizing='true']) {
      cursor: col-resize;
      user-select: none;
    }

    :global(body[data-docshelf-resizing='true'] iframe) {
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-toggle {
      transition: none;
    }

    :global(.docshelf-sidebar-resizer::after) {
      transition: none;
    }
  }
</style>
