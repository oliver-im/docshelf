---
import shelf from '../generated/shelf.json';

interface Artifact {
  route: string;
  title: string;
  revision: string;
  embedUrl?: string;
  source?: string;
  sourceType?: 'claude' | 'github-markdown';
  rawUrl?: string;
  linkBaseUrl?: string;
  frameUrl?: string;
  imported?: boolean;
}

const artifacts = shelf.artifacts as Artifact[];
const initialArtifact = artifacts[0];
const basePath = import.meta.env.BASE_URL;
const liveUpdatesEnabled = import.meta.env.DOCSHELF_LIVE_UPDATES !== 'false';
const initialFrameUrl = initialArtifact
  ? initialArtifact.embedUrl ||
    `${basePath}artifacts/${initialArtifact.route}?__docshelf_revision=${initialArtifact.revision}`
  : '';
const blankFrameUrl = 'about:blank';
---

<div
  class="docshelf-viewer"
  data-docshelf-viewer
  data-artifacts={JSON.stringify(artifacts)}
  data-shelf-revision={shelf.shelfRevision}
  data-docshelf-live-updates={String(liveUpdatesEnabled)}
>
  {
    liveUpdatesEnabled && (
      <div
        class="build-status-banner"
        data-docshelf-build-status
        role="alert"
        aria-atomic="true"
        hidden
      >
        <strong>Rebuild failed.</strong>
        <span data-docshelf-build-status-message></span>
      </div>
    )
  }
  <div class="artifact-load-error" data-docshelf-artifact-error role="alert" hidden>
    <strong>Could not load document.</strong>
    <span data-docshelf-artifact-error-message></span>
  </div>
  {
    <>
      <section
        class="document-pane"
        aria-label="Document viewer"
        aria-busy="false"
        hidden={!initialArtifact}
      >
        <iframe
          data-document-frame
          data-frame-state="active"
          data-frame-ready={initialArtifact ? 'loading' : 'false'}
          data-artifact-route={initialArtifact?.route || ''}
          data-artifact-revision={initialArtifact?.revision || ''}
          data-artifact-query=""
          data-artifact-location=""
          data-artifact-url={initialFrameUrl}
          src={initialFrameUrl || blankFrameUrl}
          title={initialArtifact?.title || 'Document viewer'}
          allow="clipboard-write"
          allowfullscreen
        />
        <iframe
          data-document-frame
          data-frame-state="standby"
          data-frame-ready="false"
          data-artifact-route=""
          data-artifact-revision=""
          data-artifact-query=""
          data-artifact-location=""
          data-artifact-url=""
          title="Document preload"
          aria-hidden="true"
          tabindex="-1"
          allow="clipboard-write"
          allowfullscreen
        />
      </section>
      <div class="empty-state" hidden={Boolean(initialArtifact)} data-docshelf-empty-state>
        <h2>No artifacts are registered</h2>
        <p>Add an entry to <code>shelf.local.json</code> or add public GitHub Markdown.</p>
      </div>
    </>
  }

  <dialog class="import-dialog" data-docshelf-import-dialog aria-labelledby="import-dialog-title">
    <form data-docshelf-import-form novalidate>
      <div class="import-dialog-heading">
        <div>
          <h2 id="import-dialog-title">Add to shelf</h2>
          <p>Paste a public GitHub Markdown or Claude Artifact URL.</p>
        </div>
        <button class="dialog-close" type="button" data-docshelf-import-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <label for="import-document-url">Document URL</label>
      <input
        id="import-document-url"
        name="source"
        type="url"
        inputmode="url"
        autocomplete="url"
        autocapitalize="off"
        spellcheck="false"
        placeholder="https://github.com/owner/repository/blob/main/README.md"
        aria-describedby="import-document-note import-document-error"
        required
      />

      <label for="import-document-title">Name <span>(optional)</span></label>
      <input
        id="import-document-title"
        name="title"
        type="text"
        maxlength="120"
        placeholder="Inferred from the document"
      />

      <p class="import-note" id="import-document-note">
        Public GitHub Markdown works immediately. For Claude, the owner must add
        <strong data-docshelf-import-origin></strong> to the Artifact’s allowed domains. Imports
        are remembered only in this browser.
      </p>
      <p
        class="import-error"
        id="import-document-error"
        data-docshelf-import-error
        role="alert"
        hidden
      ></p>

      <div class="import-dialog-actions">
        <button class="forget-button" type="button" data-docshelf-import-forget hidden>
          Forget imported documents
        </button>
        <span></span>
        <button class="cancel-button" type="button" data-docshelf-import-close>Cancel</button>
        <button class="submit-button" type="submit">Add document</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { parseClaudeArtifactUrl } from '../lib/claude-artifacts.js';
  import { artifactsShareRemoteSource } from '../lib/artifact-identity.js';
  import { parseGitHubMarkdownUrl } from '../lib/github-markdown.js';

  interface Artifact {
    route: string;
    title: string;
    revision: string;
    embedUrl?: string;
    source?: string;
    sourceType?: 'claude' | 'github-markdown';
    rawUrl?: string;
    linkBaseUrl?: string;
    frameUrl?: string;
    framePromise?: Promise<string>;
    imported?: boolean;
  }

  interface ArtifactSelection {
    route: string;
    query: string;
    hash: string;
  }

  interface RevisionState {
    version: number;
    shelfRevision: string;
    artifacts: Array<{ route: string; revision: string }>;
  }

  interface BuildStatus {
    version: number;
    state: 'starting' | 'building' | 'ready' | 'failed';
    error: { message: string; details: string | null } | null;
  }

  const basePath = import.meta.env.BASE_URL;
  const artifactRootPath = `${basePath}artifacts/`;
  const revisionStateUrl = `${artifactRootPath}.docshelf-revisions.json`;
  const buildStatusUrl = `${basePath}__docshelf/status`;
  const revisionParameter = '__docshelf_revision';
  const revisionPollInterval = 3_000;
  const importedArtifactsStorageKey = 'docshelf:imported-artifacts';
  const legacyClaudeArtifactsStorageKey = 'docshelf:claude-artifacts';

  const viewer = document.querySelector<HTMLElement>('[data-docshelf-viewer]');

  if (viewer && viewer.dataset.initialized !== 'true') {
    viewer.dataset.initialized = 'true';
    initializeBuildStatus(viewer);
    initializeViewer(viewer);
  }

  function initializeBuildStatus(root: HTMLElement) {
    const banner = root.querySelector<HTMLElement>('[data-docshelf-build-status]');
    const message = root.querySelector<HTMLElement>('[data-docshelf-build-status-message]');
    if (!banner || !message) return;

    let checking = false;
    const check = async () => {
      if (checking) return;
      checking = true;
      try {
        const response = await fetch(buildStatusUrl, { cache: 'no-store' });
        if (!response.ok) return;
        const status = (await response.json()) as BuildStatus;
        if (!validBuildStatus(status)) return;

        if (status.state === 'failed' && status.error) {
          message.textContent = status.error.details
            ? `${status.error.message}: ${status.error.details}`
            : status.error.message;
          banner.hidden = false;
        } else {
          message.textContent = '';
          banner.hidden = true;
        }
      } catch {
        // Keep the last known status when the watcher cannot be reached temporarily.
      } finally {
        checking = false;
      }
    };

    void check();
    window.addEventListener('focus', () => void check());
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void check();
    });
    window.setInterval(() => {
      if (document.visibilityState === 'visible') void check();
    }, revisionPollInterval);
  }

  function initializeViewer(root: HTMLElement) {
    const artifacts = JSON.parse(root.dataset.artifacts || '[]') as Artifact[];
    const pane = root.querySelector<HTMLElement>('.document-pane');
    const emptyState = root.querySelector<HTMLElement>('[data-docshelf-empty-state]');
    const artifactError = root.querySelector<HTMLElement>('[data-docshelf-artifact-error]');
    const artifactErrorMessage = root.querySelector<HTMLElement>(
      '[data-docshelf-artifact-error-message]',
    );
    const frames = Array.from(
      root.querySelectorAll<HTMLIFrameElement>('[data-document-frame]'),
    );
    const initialActiveFrame = frames.find((frame) => frame.dataset.frameState === 'active');
    const initialStagingFrame = frames.find((frame) => frame !== initialActiveFrame);

    if (
      !pane ||
      !emptyState ||
      !artifactError ||
      !artifactErrorMessage ||
      !initialActiveFrame ||
      !initialStagingFrame
    ) {
      return;
    }

    const documentPane: HTMLElement = pane;
    const viewerEmptyState: HTMLElement = emptyState;
    const viewerArtifactError: HTMLElement = artifactError;
    const viewerArtifactErrorMessage: HTMLElement = artifactErrorMessage;
    const importedArtifacts = readImportedArtifacts().filter(
      (imported) =>
        !artifacts.some(
          (hosted) =>
            hosted.route === imported.route || artifactsShareRemoteSource(hosted, imported),
        ),
    );
    for (const artifact of importedArtifacts) {
      artifacts.push(artifact);
    }
    let activeFrame: HTMLIFrameElement = initialActiveFrame;
    let stagingFrame: HTMLIFrameElement = initialStagingFrame;

    const sidebarLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#starlight__sidebar a[href]'),
    )
      .map((link) => ({ link, route: artifactRouteFromLink(link) }))
      .filter((entry): entry is { link: HTMLAnchorElement; route: string } => Boolean(entry.route));

    let currentArtifact: Artifact | undefined;
    let currentSelection: ArtifactSelection | undefined;
    let navigationId = 0;
    let checkingRevisions = false;
    const bridgedDocuments = new WeakSet<Document>();
    const pendingRefreshes = new Set<string>();

    initializeImportDialog();

    for (const frame of frames) {
      frame.addEventListener('load', () => {
        bridgeFrameLinks(frame);
        if (
          currentArtifact &&
          supportsLineSelection(currentArtifact) &&
          frame === activeFrame &&
          currentSelection &&
          frame.dataset.artifactRoute === currentArtifact.route
        ) {
          applyLineSelectionToFrame(frame, currentSelection);
        }
        if (frame.dataset.frameState !== 'loading') {
          frame.dataset.frameReady = frameHasLoadedDatasetUrl(frame) ? 'true' : 'false';
        }
      });
      bridgeFrameLinks(frame);
    }

    for (const { link, route } of sidebarLinks) {
      registerSidebarLink(link, route);
    }
    for (const artifact of importedArtifacts) addImportedSidebarLink(artifact);

    function registerSidebarLink(link: HTMLAnchorElement, route: string) {
      link.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        event.preventDefault();
        selectArtifact(emptySelection(route), 'push');
        closeMobileNavigation();
      });
    }

    const search = document.querySelector<HTMLElement>('site-search');
    search?.addEventListener('click', (event) => {
      if (
        event.defaultPrevented || event.button !== 0 ||
        event.metaKey || event.ctrlKey || event.shiftKey || event.altKey
      ) return;

      const link = event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>('a[href]')
        : null;
      const route = link && artifactRouteFromLink(link);
      if (
        !link || !route || !artifacts.some((artifact) => artifact.route === route) ||
        link.hasAttribute('download') || (link.target && link.target.toLowerCase() !== '_self')
      ) return;

      event.preventDefault();
      const destination = new URL(link.href);
      selectArtifact({ route, query: destination.search.slice(1), hash: destination.hash }, 'push');
      search.querySelector<HTMLDialogElement>('dialog[open]')?.close();
      closeMobileNavigation();
      search.querySelector<HTMLButtonElement>('button[data-open-modal]')?.focus({ preventScroll: true });
    });

    window.addEventListener('popstate', () => {
      const fallback = artifacts[0];
      if (fallback) selectArtifact(requestedSelection() || emptySelection(fallback.route), 'none');
    });
    window.addEventListener('message', handleFrameMessage);
    if (root.dataset.docshelfLiveUpdates === 'true') {
      window.addEventListener('focus', () => void checkForArtifactUpdates());
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') void checkForArtifactUpdates();
      });
      window.setInterval(() => {
        if (document.visibilityState === 'visible') void checkForArtifactUpdates();
      }, revisionPollInterval);
    }

    if (artifacts.length > 0) {
      showDocumentPane();
      selectArtifact(requestedSelection() || emptySelection(artifacts[0].route), 'none');
    } else {
      showEmptyState();
    }

    function initializeImportDialog() {
      const dialog = root.querySelector<HTMLDialogElement>('[data-docshelf-import-dialog]');
      const form = root.querySelector<HTMLFormElement>('[data-docshelf-import-form]');
      const sourceInput = form?.elements.namedItem('source');
      const titleInput = form?.elements.namedItem('title');
      const error = root.querySelector<HTMLElement>('[data-docshelf-import-error]');
      const origin = root.querySelector<HTMLElement>('[data-docshelf-import-origin]');
      const forgetButton = root.querySelector<HTMLButtonElement>('[data-docshelf-import-forget]');
      const openButton = document.querySelector<HTMLButtonElement>('[data-docshelf-import-open]');
      const closeButtons = root.querySelectorAll<HTMLButtonElement>('[data-docshelf-import-close]');
      const submitButton = form?.querySelector<HTMLButtonElement>('[type="submit"]');

      if (
        !dialog ||
        !form ||
        !(sourceInput instanceof HTMLInputElement) ||
        !(titleInput instanceof HTMLInputElement) ||
        !error ||
        !origin ||
        !forgetButton ||
        !openButton ||
        !submitButton
      ) {
        return;
      }

      const importForm: HTMLFormElement = form;
      const importSubmitButton: HTMLButtonElement = submitButton;
      let importAttempt = 0;
      origin.textContent = window.location.origin;
      forgetButton.hidden = importedArtifacts.length === 0;
      const closeDialog = () => {
        if (typeof dialog.close === 'function') dialog.close();
        else {
          dialog.removeAttribute('open');
          dialog.dispatchEvent(new Event('close'));
        }
      };
      openButton.addEventListener('click', () => {
        error.hidden = true;
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
        sourceInput.focus();
      });
      for (const button of closeButtons) button.addEventListener('click', closeDialog);
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });
      dialog.addEventListener('close', () => {
        importAttempt += 1;
        setImportPending(false);
        form.reset();
        error.hidden = true;
      });
      forgetButton.addEventListener('click', () => {
        removeStoredImportedArtifacts();
        window.location.reload();
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (importSubmitButton.disabled) return;
        const attempt = ++importAttempt;
        const source = sourceInput.value.trim();
        const claudeSource = parseClaudeArtifactUrl(source);
        const markdownSource = parseGitHubMarkdownUrl(source);
        if (!claudeSource && !markdownSource) {
          error.textContent =
            'Enter a public GitHub Markdown file or a public Claude Artifact URL.';
          error.hidden = false;
          sourceInput.focus();
          return;
        }

        const requestedTitle = titleInput.value.trim();
        const candidate = claudeSource
          ? importedClaudeArtifact(
              claudeSource,
              requestedTitle || `Claude Artifact ${claudeSource.artifactId.slice(0, 8)}`,
            )
          : importedGitHubMarkdown(markdownSource!, requestedTitle);
        const existingBySource = artifacts.find((artifact) =>
          artifactsShareRemoteSource(artifact, candidate),
        );
        if (existingBySource && !existingBySource.imported) {
          error.textContent = 'This document is already part of the hosted shelf.';
          error.hidden = false;
          return;
        }

        const existingByRoute = artifacts.find(
          (artifact) => artifact.route === candidate.route,
        );
        if (existingByRoute && existingByRoute !== existingBySource) {
          error.textContent = 'Another document already uses this import’s generated route.';
          error.hidden = false;
          return;
        }

        const existing = existingBySource || existingByRoute;
        const artifact = existing ? { ...existing } : candidate;
        if (requestedTitle) artifact.title = requestedTitle;
        error.hidden = true;
        setImportPending(true);

        try {
          if (artifact.sourceType === 'github-markdown') {
            if (requestedTitle && artifact.frameUrl) {
              delete artifact.frameUrl;
              delete artifact.framePromise;
            }
            await resolveArtifactFrameUrl(artifact);
          }

          if (attempt !== importAttempt || !dialog.hasAttribute('open')) {
            if (artifact.frameUrl !== existing?.frameUrl) releaseArtifactFrame(artifact);
            return;
          }

          if (existing) {
            if (existing.frameUrl !== artifact.frameUrl) releaseArtifactFrame(existing);
            Object.assign(existing, artifact);
            const existingLink = sidebarLinks.find((entry) => entry.route === artifact.route)?.link;
            if (existingLink) existingLink.textContent = artifact.title;
          } else {
            artifacts.push(artifact);
            importedArtifacts.push(artifact);
            addImportedSidebarLink(artifact);
          }
          writeImportedArtifacts(importedArtifacts);
          forgetButton.hidden = false;
          closeDialog();
          showDocumentPane();
          selectArtifact(emptySelection(artifact.route), 'push', true);
        } catch (caught) {
          if (attempt !== importAttempt || !dialog.hasAttribute('open')) return;
          error.textContent = importErrorMessage(caught);
          error.hidden = false;
        } finally {
          if (attempt === importAttempt) setImportPending(false);
        }
      });

      function setImportPending(pending: boolean) {
        importForm.setAttribute('aria-busy', String(pending));
        importSubmitButton.disabled = pending;
        importSubmitButton.textContent = pending ? 'Adding…' : 'Add document';
      }
    }

    function addImportedSidebarLink(artifact: Artifact) {
      const topLevel = document.querySelector<HTMLUListElement>(
        '#starlight__sidebar ul.top-level',
      );
      if (!topLevel || topLevel.querySelector(`[data-docshelf-route="${artifact.route}"]`)) return;

      let list = topLevel.querySelector<HTMLUListElement>('[data-docshelf-imported-list]');
      if (!list) {
        const group = document.createElement('li');
        group.dataset.docshelfImportedGroup = '';
        const label = document.createElement('div');
        label.className = 'docshelf-imported-label';
        label.textContent = 'Imported';
        list = document.createElement('ul');
        list.dataset.docshelfImportedList = '';
        group.append(label, list);
        topLevel.append(group);
      }

      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = artifactViewerUrl(emptySelection(artifact.route));
      link.dataset.docshelfRoute = artifact.route;
      link.textContent = artifact.title;
      item.append(link);
      list.append(item);
      sidebarLinks.push({ link, route: artifact.route });
      registerSidebarLink(link, artifact.route);
    }

    function showDocumentPane() {
      documentPane.hidden = false;
      viewerEmptyState.hidden = true;
    }

    function showEmptyState() {
      documentPane.hidden = true;
      viewerEmptyState.hidden = false;
    }

    function closeMobileNavigation() {
      // Frame swaps do not navigate the page, so use Starlight's toggle to
      // dismiss its mobile menu and release the focus trap together.
      const toggle = document.querySelector<HTMLButtonElement>(
        'starlight-menu-button[aria-expanded="true"] button',
      );
      if (toggle) {
        toggle.click();
        toggle.focus({ preventScroll: true });
      }
    }

    function selectArtifact(
      requested: ArtifactSelection,
      historyMode: 'push' | 'replace' | 'none',
      forceRefresh = false,
    ) {
      const artifact =
        artifacts.find((candidate) => candidate.route === requested.route) || artifacts[0];
      if (!artifact) return;

      const selection =
        artifact.route === requested.route
          ? normalizeSelection(requested)
          : emptySelection(artifact.route);
      const changed = selectionKey(currentSelection) !== selectionKey(selection);
      currentArtifact = artifact;
      currentSelection = selection;
      document.title = `${artifact.title} | DocShelf`;
      hideArtifactError();

      if (changed || forceRefresh) void displayArtifact(artifact, selection);

      for (const entry of sidebarLinks) {
        const isCurrent = entry.route === artifact.route;
        if (isCurrent) {
          entry.link.setAttribute('data-docshelf-current', '');
          entry.link.setAttribute('aria-current', 'page');
        } else {
          entry.link.removeAttribute('data-docshelf-current');
          entry.link.removeAttribute('aria-current');
        }
      }

      if (historyMode !== 'none' && selectionKey(requestedSelection()) !== selectionKey(selection)) {
        window.history[historyMode === 'replace' ? 'replaceState' : 'pushState'](
          { artifact: artifact.route },
          '',
          artifactViewerUrl(selection),
        );
      }
    }

    async function displayArtifact(artifact: Artifact, selection: ArtifactSelection) {
      const requestId = ++navigationId;
      documentPane.setAttribute('aria-busy', 'true');

      let rawUrl;
      try {
        rawUrl = await resolveArtifactFrameUrl(artifact, selection);
      } catch (caught) {
        if (requestId === navigationId) {
          showArtifactError(importErrorMessage(caught));
          pendingRefreshes.delete(artifact.route);
          documentPane.setAttribute('aria-busy', 'false');
        }
        return;
      }
      if (requestId !== navigationId) return;
      pendingRefreshes.add(artifact.route);

      if (
        frameMatches(activeFrame, artifact, selection) &&
        activeFrame.dataset.frameReady !== 'false'
      ) {
        pendingRefreshes.delete(artifact.route);
        activeFrame.title = artifact.title;
        bridgeFrameLinks(activeFrame);
        if (supportsLineSelection(artifact)) applyLineSelectionToFrame(activeFrame, selection);
        documentPane.setAttribute('aria-busy', 'false');
        return;
      }

      if (
        supportsLineSelection(artifact) &&
        frameCanApplyFragment(activeFrame, artifact, selection) &&
        activeFrame.dataset.frameReady !== 'false'
      ) {
        activeFrame.dataset.artifactLocation = artifactLocation(selection);
        activeFrame.dataset.artifactUrl = rawUrl;
        pendingRefreshes.delete(artifact.route);
        activeFrame.title = artifact.title;
        bridgeFrameLinks(activeFrame);
        applyLineSelectionToFrame(activeFrame, selection);
        documentPane.setAttribute('aria-busy', 'false');
        return;
      }

      if (
        frameMatches(stagingFrame, artifact, selection) &&
        frameHasLoadedDatasetUrl(stagingFrame) &&
        stagingFrame.dataset.frameReady === 'true'
      ) {
        await waitForPaint();
        if (requestId === navigationId) swapFrames(stagingFrame, artifact, selection);
        return;
      }

      const expectsDarkReader =
        documentUsesDarkReader(document) || frameUsesDarkReader(activeFrame);

      stagingFrame.dataset.frameState = 'loading';
      stagingFrame.dataset.frameReady = 'false';
      stagingFrame.dataset.artifactRoute = artifact.route;
      stagingFrame.dataset.artifactRevision = artifact.revision;
      stagingFrame.dataset.artifactQuery = selection.query;
      stagingFrame.dataset.artifactLocation = artifactLocation(selection);
      stagingFrame.dataset.artifactUrl = rawUrl;
      stagingFrame.title = artifact.title;
      stagingFrame.setAttribute('aria-hidden', 'true');
      stagingFrame.tabIndex = -1;

      const loaded = await loadFrame(stagingFrame, rawUrl);
      if (!loaded || requestId !== navigationId) {
        if (requestId === navigationId) {
          stagingFrame.dataset.frameState = 'standby';
          documentPane.setAttribute('aria-busy', 'false');
        }
        return;
      }

      await waitForFrameToSettle(stagingFrame, expectsDarkReader);
      if (requestId !== navigationId) return;

      bridgeFrameLinks(stagingFrame);
      stagingFrame.dataset.frameReady = 'true';
      swapFrames(stagingFrame, artifact, selection);
    }

    function swapFrames(
      nextFrame: HTMLIFrameElement,
      artifact: Artifact,
      selection: ArtifactSelection,
    ) {
      const previousFrame = activeFrame;

      if (frameHasLoadedDatasetUrl(previousFrame)) {
        previousFrame.dataset.frameReady = 'true';
      }

      nextFrame.dataset.frameState = 'active';
      nextFrame.title = artifact.title;
      nextFrame.removeAttribute('aria-hidden');
      nextFrame.removeAttribute('tabindex');

      previousFrame.dataset.frameState = 'standby';
      previousFrame.setAttribute('aria-hidden', 'true');
      previousFrame.tabIndex = -1;

      activeFrame = nextFrame;
      stagingFrame = previousFrame;
      if (supportsLineSelection(artifact)) applyLineSelectionToFrame(activeFrame, selection);
      pendingRefreshes.delete(artifact.route);
      documentPane.setAttribute('aria-busy', 'false');
    }

    function showArtifactError(message: string) {
      viewerArtifactErrorMessage.textContent = message;
      viewerArtifactError.hidden = false;
    }

    function hideArtifactError() {
      viewerArtifactErrorMessage.textContent = '';
      viewerArtifactError.hidden = true;
    }

    function handleFrameMessage(event: MessageEvent) {
      if (
        event.origin !== window.location.origin ||
        event.source !== activeFrame.contentWindow ||
        event.data?.type !== 'docshelf-line-selection' ||
        !currentArtifact ||
        !currentSelection ||
        activeFrame.dataset.artifactRoute !== currentArtifact.route
      ) {
        return;
      }

      const hash = event.data.hash;
      if (typeof hash !== 'string' || (hash && !hash.startsWith('#'))) return;
      try {
        // Ignore a queued message if the frame has already navigated again.
        // Blob-backed imports keep their selection in the parent URL only.
        if (!currentArtifact.frameUrl && activeFrame.contentWindow?.location.hash !== hash) return;
      } catch {
        return;
      }

      const selection = normalizeSelection({
        ...currentSelection,
        hash,
      });
      if (selectionKey(selection) === selectionKey(currentSelection)) return;

      currentSelection = selection;
      activeFrame.dataset.artifactLocation = artifactLocation(selection);
      activeFrame.dataset.artifactUrl = artifactFrameUrl(currentArtifact, selection);
      const historyMode = event.data.historyMode === 'replace' ? 'replace' : 'push';
      window.history[historyMode === 'replace' ? 'replaceState' : 'pushState'](
        { artifact: currentArtifact.route },
        '',
        artifactViewerUrl(selection),
      );
    }

    function bridgeFrameLinks(frame: HTMLIFrameElement) {
      let frameDocument: Document | null = null;
      try {
        frameDocument = frame.contentDocument;
      } catch {
        return;
      }

      if (!frameDocument || bridgedDocuments.has(frameDocument)) return;
      bridgedDocuments.add(frameDocument);
      frameDocument.addEventListener('click', (event) => {
        const mouseEvent = event as MouseEvent;
        if (
          event.defaultPrevented ||
          mouseEvent.button !== 0 ||
          mouseEvent.metaKey ||
          mouseEvent.ctrlKey ||
          mouseEvent.shiftKey ||
          mouseEvent.altKey
        ) {
          return;
        }

        const eventElement =
          event.target && 'closest' in event.target ? (event.target as Element) : null;
        const link = eventElement?.closest<HTMLAnchorElement>('a[data-docshelf-artifact]');
        const route = link?.dataset.docshelfArtifact;
        const linkTarget = link?.target.toLowerCase();
        if (
          !link ||
          !route ||
          !artifacts.some((artifact) => artifact.route === route) ||
          (linkTarget && linkTarget !== '_self' && linkTarget !== '_top')
        ) {
          return;
        }

        event.preventDefault();
        const destination = new URL(link.href, window.location.href);
        selectArtifact(
          normalizeSelection({
            route,
            query: destination.searchParams.get('artifact-query') || '',
            hash: destination.hash,
          }),
          'push',
        );
      });
    }

    async function checkForArtifactUpdates() {
      if (checkingRevisions) return;
      checkingRevisions = true;

      try {
        const response = await fetch(revisionStateUrl, { cache: 'no-store' });
        if (!response.ok) return;
        const state = (await response.json()) as RevisionState;
        if (!validRevisionState(state)) return;

        if (state.shelfRevision !== root.dataset.shelfRevision) {
          window.location.reload();
          return;
        }

        const revisions = new Map(
          state.artifacts.map((artifact) => [artifact.route, artifact.revision]),
        );
        let refreshCurrent = false;

        for (const artifact of artifacts) {
          const revision = revisions.get(artifact.route);
          if (!revision || revision === artifact.revision) continue;

          artifact.revision = revision;
          for (const frame of frames) {
            if (
              frame.dataset.artifactRoute === artifact.route &&
              frame.dataset.artifactRevision !== revision
            ) {
              frame.dataset.frameReady = 'false';
            }
          }
          if (currentSelection?.route === artifact.route) refreshCurrent = true;
        }

        if (refreshCurrent && currentArtifact && currentSelection) {
          selectArtifact(currentSelection, 'none', true);
        } else if (
          currentArtifact &&
          currentSelection &&
          pendingRefreshes.has(currentArtifact.route) &&
          !frames.some(
            (frame) =>
              frame.dataset.frameState === 'loading' &&
              frameMatches(
                frame,
                currentArtifact as Artifact,
                currentSelection as ArtifactSelection,
              ),
          )
        ) {
          selectArtifact(currentSelection, 'none', true);
        }
      } catch {
        // The previous successful build remains usable while the watcher rebuilds.
      } finally {
        checkingRevisions = false;
      }
    }
  }

  function importedClaudeArtifact(
    parsed: NonNullable<ReturnType<typeof parseClaudeArtifactUrl>>,
    title: string,
  ): Artifact {
    const revisionSeed = parsed.artifactId.replaceAll('-', '');
    return {
      route: `claude/${parsed.artifactId}.html`,
      title,
      revision: `${revisionSeed}${revisionSeed}`,
      source: parsed.publicUrl,
      sourceType: 'claude',
      embedUrl: parsed.embedUrl,
      imported: true,
    };
  }

  function importedGitHubMarkdown(
    parsed: NonNullable<ReturnType<typeof parseGitHubMarkdownUrl>>,
    title: string,
  ): Artifact {
    const identity = stableHash(parsed.rawUrl);
    const revisionSeed = `${identity}${stableHash(parsed.rawUrl, 0x9e3779b9)}`;
    const fileSlug = parsed.fileName
      .replace(/\.(?:md|markdown)$/i, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '') || 'document';

    return {
      route: `github/${parsed.owner.toLowerCase()}/${parsed.repository.toLowerCase()}/${fileSlug}-${identity}.html`,
      title,
      revision: revisionSeed.repeat(4),
      source: parsed.sourceUrl,
      sourceType: 'github-markdown',
      rawUrl: parsed.rawUrl,
      linkBaseUrl: parsed.linkBaseUrl,
      imported: true,
    };
  }

  function readImportedArtifacts(): Artifact[] {
    try {
      const stored = [
        ...readStoredEntries(importedArtifactsStorageKey),
        ...readStoredEntries(legacyClaudeArtifactsStorageKey),
      ];

      const artifacts: Artifact[] = [];
      for (const entry of stored) {
        if (
          !entry ||
          typeof entry !== 'object' ||
          !('source' in entry) ||
          !('title' in entry) ||
          typeof entry.source !== 'string' ||
          typeof entry.title !== 'string'
        ) {
          continue;
        }
        const title = entry.title.trim().slice(0, 120);
        if (!title) continue;

        const claudeSource = parseClaudeArtifactUrl(entry.source);
        const markdownSource = parseGitHubMarkdownUrl(entry.source);
        const artifact = claudeSource
          ? importedClaudeArtifact(claudeSource, title)
          : markdownSource
            ? importedGitHubMarkdown(markdownSource, title)
            : null;
        if (!artifact) continue;
        if (
          !artifacts.some(
            (candidate) =>
              candidate.route === artifact.route ||
              artifactsShareRemoteSource(candidate, artifact),
          )
        ) {
          artifacts.push(artifact);
        }
      }
      return artifacts;
    } catch {
      return [];
    }
  }

  function readStoredEntries(key: string): unknown[] {
    const stored = JSON.parse(window.localStorage.getItem(key) || '[]');
    return Array.isArray(stored) ? stored : [];
  }

  function writeImportedArtifacts(artifacts: Artifact[]) {
    try {
      window.localStorage.setItem(
        importedArtifactsStorageKey,
        JSON.stringify(artifacts.map(({ source, title }) => ({ source, title }))),
      );
    } catch {
      // The opened Artifact remains usable for this page load when storage is unavailable.
    }
  }

  function removeStoredImportedArtifacts() {
    try {
      window.localStorage.removeItem(importedArtifactsStorageKey);
      window.localStorage.removeItem(legacyClaudeArtifactsStorageKey);
    } catch {
      // Reloading still resets any in-memory imports for this page load.
    }
  }

  async function resolveArtifactFrameUrl(
    artifact: Artifact,
    selection?: ArtifactSelection,
  ): Promise<string> {
    if (artifact.sourceType !== 'github-markdown') {
      return artifactFrameUrl(artifact, selection || emptySelection(artifact.route));
    }
    if (artifact.frameUrl) return artifact.frameUrl;
    if (artifact.framePromise) return artifact.framePromise;

    const loading = (async () => {
      const { fetchRemoteMarkdown, renderRemoteMarkdownDocument } =
        await import('../lib/remote-markdown.js');
      const parsed = parseGitHubMarkdownUrl(artifact.source || artifact.rawUrl || '');
      if (!parsed) throw new Error('The saved GitHub Markdown URL is no longer valid.');

      const loaded = await fetchRemoteMarkdown(artifact.rawUrl || parsed.rawUrl);
      const rendered = await renderRemoteMarkdownDocument(loaded.markdown, {
        title: artifact.title,
        fallbackTitle: parsed.fileName,
        sourceUrl: artifact.source || parsed.sourceUrl,
        assetBaseUrl: loaded.assetBaseUrl,
        linkBaseUrl: artifact.linkBaseUrl || parsed.linkBaseUrl,
        stylesheetUrl: new URL(`${basePath}markdown-tokyo-night.css`, window.location.href).href,
        lineLinksScriptUrl: new URL(
          `${basePath}markdown-line-links.js`,
          window.location.href,
        ).href,
      });
      artifact.title = rendered.title;
      artifact.frameUrl = URL.createObjectURL(
        new Blob([rendered.html], { type: 'text/html;charset=utf-8' }),
      );
      return artifact.frameUrl;
    })();

    artifact.framePromise = loading;
    try {
      return await loading;
    } finally {
      if (artifact.framePromise === loading) delete artifact.framePromise;
    }
  }

  function releaseArtifactFrame(artifact: Artifact) {
    if (artifact.frameUrl) URL.revokeObjectURL(artifact.frameUrl);
    delete artifact.frameUrl;
    delete artifact.framePromise;
  }

  function supportsLineSelection(artifact: Artifact) {
    return !artifact.embedUrl;
  }

  function importErrorMessage(caught: unknown) {
    if (!(caught instanceof Error) || !caught.message) {
      return 'Could not load this document.';
    }
    if (/failed to fetch/i.test(caught.message)) {
      return 'Could not fetch this public Markdown file from GitHub.';
    }
    return caught.message.slice(0, 240);
  }

  function stableHash(value: string, seed = 0x811c9dc5) {
    let hash = seed;
    for (let index = 0; index < value.length; index += 1) {
      hash ^= value.charCodeAt(index);
      hash = Math.imul(hash, 0x01000193);
    }
    return (hash >>> 0).toString(16).padStart(8, '0');
  }

  function loadFrame(frame: HTMLIFrameElement, rawUrl: string) {
    const expectedUrl = new URL(rawUrl, window.location.href).href;
    const isCrossOrigin = new URL(expectedUrl).origin !== window.location.origin;

    return new Promise<boolean>((resolve) => {
      const timeoutId = window.setTimeout(() => finish(false), 15_000);

      const handleLoad = () => {
        if (frameHasLoadedUrl(frame, expectedUrl)) finish(true);
      };

      const finish = (loaded: boolean) => {
        window.clearTimeout(timeoutId);
        frame.removeEventListener('load', handleLoad);
        resolve(loaded);
      };

      frame.addEventListener('load', handleLoad);
      if (isCrossOrigin) {
        frame.src = expectedUrl;
        return;
      }

      try {
        if (frame.contentWindow) {
          frame.contentWindow.location.replace(rawUrl);
        } else {
          frame.src = rawUrl;
        }
      } catch {
        frame.src = rawUrl;
      }

      if (frameHasLoadedUrl(frame, expectedUrl)) finish(true);
    });
  }

  async function waitForFrameToSettle(frame: HTMLIFrameElement, expectsDarkReader: boolean) {
    let frameDocument: Document | null = null;

    try {
      frameDocument = frame.contentDocument;
    } catch {
      // Cross-origin Claude frames can still use load + paint.
    }

    if (frameDocument?.fonts) {
      await withTimeout(frameDocument.fonts.ready, 1_500);
    }

    if (frameDocument && expectsDarkReader && !documentUsesDarkReader(frameDocument)) {
      await waitForDarkReader(frameDocument, 500);
    }

    await waitForPaint();
  }

  function waitForDarkReader(frameDocument: Document, timeout: number) {
    if (documentUsesDarkReader(frameDocument)) return Promise.resolve();

    return new Promise<void>((resolve) => {
      const root = frameDocument.documentElement;
      let timeoutId = 0;
      const observer = new MutationObserver(() => {
        if (documentUsesDarkReader(frameDocument)) finish();
      });

      const finish = () => {
        window.clearTimeout(timeoutId);
        observer.disconnect();
        resolve();
      };

      timeoutId = window.setTimeout(finish, timeout);
      observer.observe(root, {
        attributes: true,
        attributeFilter: ['data-darkreader-mode'],
      });
    });
  }

  function documentUsesDarkReader(frameDocument: Document) {
    return frameDocument.documentElement.hasAttribute('data-darkreader-mode');
  }

  function frameUsesDarkReader(frame: HTMLIFrameElement) {
    try {
      return Boolean(frame.contentDocument && documentUsesDarkReader(frame.contentDocument));
    } catch {
      return false;
    }
  }

  function frameHasLoadedDatasetUrl(frame: HTMLIFrameElement) {
    const artifactUrl = frame.dataset.artifactUrl;
    return Boolean(
      artifactUrl && frameHasLoadedUrl(frame, new URL(artifactUrl, window.location.href).href),
    );
  }

  function frameHasLoadedUrl(frame: HTMLIFrameElement, expectedUrl: string) {
    try {
      const frameDocument = frame.contentDocument;
      if (!frameDocument) return frame.src === expectedUrl;
      return (
        frameDocument.readyState === 'complete' &&
        frame.contentWindow?.location.href === expectedUrl
      );
    } catch {
      return frame.src === expectedUrl;
    }
  }

  function withTimeout<T>(promise: Promise<T>, timeout: number) {
    return Promise.race([
      promise,
      new Promise<void>((resolve) => window.setTimeout(resolve, timeout)),
    ]);
  }

  function waitForPaint() {
    return new Promise<void>((resolve) => {
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => resolve()));
    });
  }

  function artifactRouteFromLink(link: HTMLAnchorElement) {
    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin) return null;
    const selectedRoute = url.pathname === basePath && url.searchParams.get('artifact');
    if (selectedRoute) return selectedRoute;
    if (!url.pathname.startsWith(artifactRootPath)) return null;
    try {
      return decodeURIComponent(url.pathname.slice(artifactRootPath.length));
    } catch {
      return null;
    }
  }

  function frameMatches(
    frame: HTMLIFrameElement,
    artifact: Artifact,
    selection: ArtifactSelection,
  ) {
    return (
      frame.dataset.artifactRoute === artifact.route &&
      frame.dataset.artifactRevision === artifact.revision &&
      (!artifact.frameUrl || frame.dataset.artifactUrl === artifact.frameUrl) &&
      frame.dataset.artifactLocation === artifactLocation(selection)
    );
  }

  function frameCanApplyFragment(
    frame: HTMLIFrameElement,
    artifact: Artifact,
    selection: ArtifactSelection,
  ) {
    try {
      return (
        frame.dataset.artifactRoute === artifact.route &&
        frame.dataset.artifactRevision === artifact.revision &&
        (!artifact.frameUrl || frame.dataset.artifactUrl === artifact.frameUrl) &&
        frame.dataset.artifactQuery === selection.query &&
        frame.contentDocument?.querySelector<HTMLElement>('.markdown-document')
          ?.dataset.docshelfLineLinks === 'true'
      );
    } catch {
      return false;
    }
  }

  function applyLineSelectionToFrame(
    frame: HTMLIFrameElement,
    selection: ArtifactSelection,
  ) {
    frame.contentWindow?.postMessage(
      {
        type: 'docshelf-apply-line-selection',
        hash: selection.hash,
        scroll: true,
      },
      window.location.origin,
    );
  }

  function artifactFrameUrl(artifact: Artifact, selection: ArtifactSelection) {
    if (artifact.frameUrl) return artifact.frameUrl;
    if (artifact.embedUrl) return artifact.embedUrl;

    const url = new URL(`${artifactRootPath}${artifact.route}`, window.location.href);
    url.search = selection.query ? `?${selection.query}` : '';
    url.searchParams.set(revisionParameter, artifact.revision);
    url.hash = selection.hash;
    return `${url.pathname}${url.search}${url.hash}`;
  }

  function artifactViewerUrl(selection: ArtifactSelection) {
    const url = new URL(basePath, window.location.href);
    url.searchParams.set('artifact', selection.route);
    if (selection.query) url.searchParams.set('artifact-query', selection.query);
    url.hash = selection.hash;
    return `${url.pathname}${url.search}${url.hash}`;
  }

  function requestedSelection(): ArtifactSelection | null {
    const url = new URL(window.location.href);
    const route = url.searchParams.get('artifact');
    if (!route) return null;
    return normalizeSelection({
      route,
      query: url.searchParams.get('artifact-query') || '',
      hash: url.hash,
    });
  }

  function emptySelection(route: string): ArtifactSelection {
    return { route, query: '', hash: '' };
  }

  function normalizeSelection(selection: ArtifactSelection): ArtifactSelection {
    const hash = selection.hash && !selection.hash.startsWith('#')
      ? `#${selection.hash}`
      : selection.hash;
    return {
      route: selection.route,
      query: selection.query.replace(/^\?/, ''),
      hash,
    };
  }

  function artifactLocation(selection: ArtifactSelection) {
    return `${selection.query ? `?${selection.query}` : ''}${selection.hash}`;
  }

  function selectionKey(selection: ArtifactSelection | null | undefined) {
    return selection
      ? `${selection.route}\n${selection.query}\n${selection.hash}`
      : '';
  }

  function validRevisionState(state: RevisionState) {
    return (
      state?.version === 1 &&
      typeof state.shelfRevision === 'string' &&
      Array.isArray(state.artifacts) &&
      state.artifacts.every(
        (artifact) =>
          typeof artifact?.route === 'string' &&
          typeof artifact.revision === 'string' &&
          /^[a-f\d]{64}$/.test(artifact.revision),
      )
    );
  }

  function validBuildStatus(status: BuildStatus) {
    return (
      status?.version === 1 &&
      ['starting', 'building', 'ready', 'failed'].includes(status.state) &&
      (status.error === null ||
        (typeof status.error?.message === 'string' &&
          (status.error.details === null || typeof status.error.details === 'string')))
    );
  }
</script>

