---
import manifest from '../generated/artifacts.json';

interface Artifact {
  route: string;
  title: string;
  revision: string;
}

const artifacts = manifest.artifacts as Artifact[];
const initialArtifact = artifacts[0];
const basePath = import.meta.env.BASE_URL;
const liveUpdatesEnabled = import.meta.env.DOCSHELF_LIVE_UPDATES !== 'false';
const initialFrameUrl = initialArtifact
  ? `${basePath}artifacts/${initialArtifact.route}?__docshelf_revision=${initialArtifact.revision}`
  : '';
---

<div
  class="docshelf-viewer"
  data-docshelf-viewer
  data-artifacts={JSON.stringify(artifacts)}
  data-catalog-revision={manifest.catalogRevision}
  data-docshelf-live-updates={String(liveUpdatesEnabled)}
>
  {
    liveUpdatesEnabled && (
      <div
        class="build-status-banner"
        data-docshelf-build-status
        role="alert"
        aria-atomic="true"
        hidden
      >
        <strong>Rebuild failed.</strong>
        <span data-docshelf-build-status-message></span>
      </div>
    )
  }
  {
    initialArtifact ? (
      <section class="document-pane" aria-label="Document viewer" aria-busy="false">
        <iframe
          data-document-frame
          data-frame-state="active"
          data-frame-ready="loading"
          data-artifact-route={initialArtifact.route}
          data-artifact-revision={initialArtifact.revision}
          data-artifact-query=""
          data-artifact-location=""
          data-artifact-url={initialFrameUrl}
          src={initialFrameUrl}
          title={initialArtifact.title}
        />
        <iframe
          data-document-frame
          data-frame-state="standby"
          data-frame-ready="false"
          data-artifact-route=""
          data-artifact-revision=""
          data-artifact-query=""
          data-artifact-location=""
          data-artifact-url=""
          title="Document preload"
          aria-hidden="true"
          tabindex="-1"
        />
      </section>
    ) : (
      <div class="empty-state">
        <h2>No artifacts are registered</h2>
        <p>Add an entry to <code>artifacts.local.json</code> to begin.</p>
      </div>
    )
  }
</div>

<script>
  interface Artifact {
    route: string;
    title: string;
    revision: string;
  }

  interface ArtifactSelection {
    route: string;
    query: string;
    hash: string;
  }

  interface RevisionState {
    version: number;
    catalogRevision: string;
    artifacts: Array<{ route: string; revision: string }>;
  }

  interface BuildStatus {
    version: number;
    state: 'starting' | 'building' | 'ready' | 'failed';
    error: { message: string; details: string | null } | null;
  }

  const basePath = import.meta.env.BASE_URL;
  const artifactRootPath = `${basePath}artifacts/`;
  const revisionStateUrl = `${artifactRootPath}.docshelf-revisions.json`;
  const buildStatusUrl = `${basePath}__docshelf/status`;
  const revisionParameter = '__docshelf_revision';
  const revisionPollInterval = 3_000;

  const viewer = document.querySelector<HTMLElement>('[data-docshelf-viewer]');

  if (viewer && viewer.dataset.initialized !== 'true') {
    viewer.dataset.initialized = 'true';
    initializeBuildStatus(viewer);
    initializeViewer(viewer);
  }

  function initializeBuildStatus(root: HTMLElement) {
    const banner = root.querySelector<HTMLElement>('[data-docshelf-build-status]');
    const message = root.querySelector<HTMLElement>('[data-docshelf-build-status-message]');
    if (!banner || !message) return;

    let checking = false;
    const check = async () => {
      if (checking) return;
      checking = true;
      try {
        const response = await fetch(buildStatusUrl, { cache: 'no-store' });
        if (!response.ok) return;
        const status = (await response.json()) as BuildStatus;
        if (!validBuildStatus(status)) return;

        if (status.state === 'failed' && status.error) {
          message.textContent = status.error.details
            ? `${status.error.message}: ${status.error.details}`
            : status.error.message;
          banner.hidden = false;
        } else {
          message.textContent = '';
          banner.hidden = true;
        }
      } catch {
        // Keep the last known status when the watcher cannot be reached temporarily.
      } finally {
        checking = false;
      }
    };

    void check();
    window.addEventListener('focus', () => void check());
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void check();
    });
    window.setInterval(() => {
      if (document.visibilityState === 'visible') void check();
    }, revisionPollInterval);
  }

  function initializeViewer(root: HTMLElement) {
    const artifacts = JSON.parse(root.dataset.artifacts || '[]') as Artifact[];
    const pane = root.querySelector<HTMLElement>('.document-pane');
    const frames = Array.from(
      root.querySelectorAll<HTMLIFrameElement>('[data-document-frame]'),
    );
    const initialActiveFrame = frames.find((frame) => frame.dataset.frameState === 'active');
    const initialStagingFrame = frames.find((frame) => frame !== initialActiveFrame);

    if (artifacts.length === 0 || !pane || !initialActiveFrame || !initialStagingFrame) return;

    const documentPane: HTMLElement = pane;
    let activeFrame: HTMLIFrameElement = initialActiveFrame;
    let stagingFrame: HTMLIFrameElement = initialStagingFrame;

    const sidebarLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#starlight__sidebar a[href]'),
    )
      .map((link) => ({ link, route: artifactRouteFromLink(link) }))
      .filter((entry): entry is { link: HTMLAnchorElement; route: string } => Boolean(entry.route));

    let currentArtifact: Artifact | undefined;
    let currentSelection: ArtifactSelection | undefined;
    let navigationId = 0;
    let checkingRevisions = false;
    const bridgedDocuments = new WeakSet<Document>();
    const pendingRefreshes = new Set<string>();

    for (const frame of frames) {
      frame.addEventListener('load', () => {
        bridgeFrameLinks(frame);
        if (
          frame === activeFrame &&
          currentArtifact &&
          currentSelection &&
          frame.dataset.artifactRoute === currentArtifact.route
        ) {
          applyLineSelectionToFrame(frame, currentSelection);
        }
        if (frame.dataset.frameState !== 'loading') {
          frame.dataset.frameReady = frameHasLoadedDatasetUrl(frame) ? 'true' : 'false';
        }
      });
      bridgeFrameLinks(frame);
    }

    for (const { link, route } of sidebarLinks) {
      link.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        event.preventDefault();
        selectArtifact(emptySelection(route), 'push');
        closeMobileNavigation();
      });
    }

    const search = document.querySelector<HTMLElement>('site-search');
    search?.addEventListener('click', (event) => {
      if (
        event.defaultPrevented || event.button !== 0 ||
        event.metaKey || event.ctrlKey || event.shiftKey || event.altKey
      ) return;

      const link = event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>('a[href]')
        : null;
      const route = link && artifactRouteFromLink(link);
      if (
        !link || !route || !artifacts.some((artifact) => artifact.route === route) ||
        link.hasAttribute('download') || (link.target && link.target.toLowerCase() !== '_self')
      ) return;

      event.preventDefault();
      const destination = new URL(link.href);
      selectArtifact({ route, query: destination.search.slice(1), hash: destination.hash }, 'push');
      search.querySelector<HTMLDialogElement>('dialog[open]')?.close();
      closeMobileNavigation();
      search.querySelector<HTMLButtonElement>('button[data-open-modal]')?.focus({ preventScroll: true });
    });

    window.addEventListener('popstate', () => {
      selectArtifact(requestedSelection() || emptySelection(artifacts[0].route), 'none');
    });
    window.addEventListener('message', handleFrameMessage);
    if (root.dataset.docshelfLiveUpdates === 'true') {
      window.addEventListener('focus', () => void checkForArtifactUpdates());
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') void checkForArtifactUpdates();
      });
      window.setInterval(() => {
        if (document.visibilityState === 'visible') void checkForArtifactUpdates();
      }, revisionPollInterval);
    }

    selectArtifact(requestedSelection() || emptySelection(artifacts[0].route), 'none');

    function closeMobileNavigation() {
      // Frame swaps do not navigate the page, so use Starlight's toggle to
      // dismiss its mobile menu and release the focus trap together.
      const toggle = document.querySelector<HTMLButtonElement>(
        'starlight-menu-button[aria-expanded="true"] button',
      );
      if (toggle) {
        toggle.click();
        toggle.focus({ preventScroll: true });
      }
    }

    function selectArtifact(
      requested: ArtifactSelection,
      historyMode: 'push' | 'replace' | 'none',
      forceRefresh = false,
    ) {
      const artifact =
        artifacts.find((candidate) => candidate.route === requested.route) || artifacts[0];
      if (!artifact) return;

      const selection =
        artifact.route === requested.route
          ? normalizeSelection(requested)
          : emptySelection(artifact.route);
      const changed = selectionKey(currentSelection) !== selectionKey(selection);
      currentArtifact = artifact;
      currentSelection = selection;
      document.title = `${artifact.title} | DocShelf`;

      if (changed || forceRefresh) void displayArtifact(artifact, selection);

      for (const entry of sidebarLinks) {
        const isCurrent = entry.route === artifact.route;
        if (isCurrent) {
          entry.link.setAttribute('data-docshelf-current', '');
          entry.link.setAttribute('aria-current', 'page');
        } else {
          entry.link.removeAttribute('data-docshelf-current');
          entry.link.removeAttribute('aria-current');
        }
      }

      if (historyMode !== 'none' && selectionKey(requestedSelection()) !== selectionKey(selection)) {
        window.history[historyMode === 'replace' ? 'replaceState' : 'pushState'](
          { artifact: artifact.route },
          '',
          artifactViewerUrl(selection),
        );
      }
    }

    async function displayArtifact(artifact: Artifact, selection: ArtifactSelection) {
      const requestId = ++navigationId;
      const rawUrl = artifactFrameUrl(artifact, selection);

      if (
        frameMatches(activeFrame, artifact, selection) &&
        activeFrame.dataset.frameReady !== 'false'
      ) {
        pendingRefreshes.delete(artifact.route);
        activeFrame.title = artifact.title;
        bridgeFrameLinks(activeFrame);
        applyLineSelectionToFrame(activeFrame, selection);
        documentPane.setAttribute('aria-busy', 'false');
        return;
      }

      if (
        frameCanApplyFragment(activeFrame, artifact, selection) &&
        activeFrame.dataset.frameReady !== 'false'
      ) {
        activeFrame.dataset.artifactLocation = artifactLocation(selection);
        activeFrame.dataset.artifactUrl = rawUrl;
        pendingRefreshes.delete(artifact.route);
        activeFrame.title = artifact.title;
        bridgeFrameLinks(activeFrame);
        applyLineSelectionToFrame(activeFrame, selection);
        documentPane.setAttribute('aria-busy', 'false');
        return;
      }

      documentPane.setAttribute('aria-busy', 'true');
      pendingRefreshes.add(artifact.route);

      if (
        frameMatches(stagingFrame, artifact, selection) &&
        frameHasLoadedDatasetUrl(stagingFrame) &&
        stagingFrame.dataset.frameReady === 'true'
      ) {
        await waitForPaint();
        if (requestId === navigationId) swapFrames(stagingFrame, artifact, selection);
        return;
      }

      const expectsDarkReader =
        documentUsesDarkReader(document) || frameUsesDarkReader(activeFrame);

      stagingFrame.dataset.frameState = 'loading';
      stagingFrame.dataset.frameReady = 'false';
      stagingFrame.dataset.artifactRoute = artifact.route;
      stagingFrame.dataset.artifactRevision = artifact.revision;
      stagingFrame.dataset.artifactQuery = selection.query;
      stagingFrame.dataset.artifactLocation = artifactLocation(selection);
      stagingFrame.dataset.artifactUrl = rawUrl;
      stagingFrame.title = artifact.title;
      stagingFrame.setAttribute('aria-hidden', 'true');
      stagingFrame.tabIndex = -1;

      const loaded = await loadFrame(stagingFrame, rawUrl);
      if (!loaded || requestId !== navigationId) {
        if (requestId === navigationId) {
          stagingFrame.dataset.frameState = 'standby';
          documentPane.setAttribute('aria-busy', 'false');
        }
        return;
      }

      await waitForFrameToSettle(stagingFrame, expectsDarkReader);
      if (requestId !== navigationId) return;

      bridgeFrameLinks(stagingFrame);
      stagingFrame.dataset.frameReady = 'true';
      swapFrames(stagingFrame, artifact, selection);
    }

    function swapFrames(
      nextFrame: HTMLIFrameElement,
      artifact: Artifact,
      selection: ArtifactSelection,
    ) {
      const previousFrame = activeFrame;

      if (frameHasLoadedDatasetUrl(previousFrame)) {
        previousFrame.dataset.frameReady = 'true';
      }

      nextFrame.dataset.frameState = 'active';
      nextFrame.title = artifact.title;
      nextFrame.removeAttribute('aria-hidden');
      nextFrame.removeAttribute('tabindex');

      previousFrame.dataset.frameState = 'standby';
      previousFrame.setAttribute('aria-hidden', 'true');
      previousFrame.tabIndex = -1;

      activeFrame = nextFrame;
      stagingFrame = previousFrame;
      applyLineSelectionToFrame(activeFrame, selection);
      pendingRefreshes.delete(artifact.route);
      documentPane.setAttribute('aria-busy', 'false');
    }

    function handleFrameMessage(event: MessageEvent) {
      if (
        event.origin !== window.location.origin ||
        event.source !== activeFrame.contentWindow ||
        event.data?.type !== 'docshelf-line-selection' ||
        !currentArtifact ||
        !currentSelection ||
        activeFrame.dataset.artifactRoute !== currentArtifact.route
      ) {
        return;
      }

      const hash = event.data.hash;
      if (typeof hash !== 'string' || (hash && !hash.startsWith('#'))) return;
      try {
        // Ignore a queued message if the frame has already navigated again.
        if (activeFrame.contentWindow?.location.hash !== hash) return;
      } catch {
        return;
      }

      const selection = normalizeSelection({
        ...currentSelection,
        hash,
      });
      if (selectionKey(selection) === selectionKey(currentSelection)) return;

      currentSelection = selection;
      activeFrame.dataset.artifactLocation = artifactLocation(selection);
      activeFrame.dataset.artifactUrl = artifactFrameUrl(currentArtifact, selection);
      const historyMode = event.data.historyMode === 'replace' ? 'replace' : 'push';
      window.history[historyMode === 'replace' ? 'replaceState' : 'pushState'](
        { artifact: currentArtifact.route },
        '',
        artifactViewerUrl(selection),
      );
    }

    function bridgeFrameLinks(frame: HTMLIFrameElement) {
      let frameDocument: Document | null = null;
      try {
        frameDocument = frame.contentDocument;
      } catch {
        return;
      }

      if (!frameDocument || bridgedDocuments.has(frameDocument)) return;
      bridgedDocuments.add(frameDocument);
      frameDocument.addEventListener('click', (event) => {
        const mouseEvent = event as MouseEvent;
        if (
          event.defaultPrevented ||
          mouseEvent.button !== 0 ||
          mouseEvent.metaKey ||
          mouseEvent.ctrlKey ||
          mouseEvent.shiftKey ||
          mouseEvent.altKey
        ) {
          return;
        }

        const eventElement =
          event.target && 'closest' in event.target ? (event.target as Element) : null;
        const link = eventElement?.closest<HTMLAnchorElement>('a[data-docshelf-artifact]');
        const route = link?.dataset.docshelfArtifact;
        const linkTarget = link?.target.toLowerCase();
        if (
          !link ||
          !route ||
          !artifacts.some((artifact) => artifact.route === route) ||
          (linkTarget && linkTarget !== '_self' && linkTarget !== '_top')
        ) {
          return;
        }

        event.preventDefault();
        const destination = new URL(link.href, window.location.href);
        selectArtifact(
          normalizeSelection({
            route,
            query: destination.searchParams.get('artifact-query') || '',
            hash: destination.hash,
          }),
          'push',
        );
      });
    }

    async function checkForArtifactUpdates() {
      if (checkingRevisions) return;
      checkingRevisions = true;

      try {
        const response = await fetch(revisionStateUrl, { cache: 'no-store' });
        if (!response.ok) return;
        const state = (await response.json()) as RevisionState;
        if (!validRevisionState(state)) return;

        if (state.catalogRevision !== root.dataset.catalogRevision) {
          window.location.reload();
          return;
        }

        const revisions = new Map(
          state.artifacts.map((artifact) => [artifact.route, artifact.revision]),
        );
        let refreshCurrent = false;

        for (const artifact of artifacts) {
          const revision = revisions.get(artifact.route);
          if (!revision || revision === artifact.revision) continue;

          artifact.revision = revision;
          for (const frame of frames) {
            if (
              frame.dataset.artifactRoute === artifact.route &&
              frame.dataset.artifactRevision !== revision
            ) {
              frame.dataset.frameReady = 'false';
            }
          }
          if (currentSelection?.route === artifact.route) refreshCurrent = true;
        }

        if (refreshCurrent && currentArtifact && currentSelection) {
          selectArtifact(currentSelection, 'none', true);
        } else if (
          currentArtifact &&
          currentSelection &&
          pendingRefreshes.has(currentArtifact.route) &&
          !frames.some(
            (frame) =>
              frame.dataset.frameState === 'loading' &&
              frameMatches(
                frame,
                currentArtifact as Artifact,
                currentSelection as ArtifactSelection,
              ),
          )
        ) {
          selectArtifact(currentSelection, 'none', true);
        }
      } catch {
        // The previous successful build remains usable while the watcher rebuilds.
      } finally {
        checkingRevisions = false;
      }
    }
  }

  function loadFrame(frame: HTMLIFrameElement, rawUrl: string) {
    const expectedUrl = new URL(rawUrl, window.location.href).href;

    return new Promise<boolean>((resolve) => {
      const timeoutId = window.setTimeout(() => finish(false), 15_000);

      const handleLoad = () => {
        if (frameHasLoadedUrl(frame, expectedUrl)) finish(true);
      };

      const finish = (loaded: boolean) => {
        window.clearTimeout(timeoutId);
        frame.removeEventListener('load', handleLoad);
        resolve(loaded);
      };

      frame.addEventListener('load', handleLoad);
      try {
        if (frame.contentWindow) {
          frame.contentWindow.location.replace(rawUrl);
        } else {
          frame.src = rawUrl;
        }
      } catch {
        frame.src = rawUrl;
      }

      if (frameHasLoadedUrl(frame, expectedUrl)) finish(true);
    });
  }

  async function waitForFrameToSettle(frame: HTMLIFrameElement, expectsDarkReader: boolean) {
    let frameDocument: Document | null = null;

    try {
      frameDocument = frame.contentDocument;
    } catch {
      // Artifacts are normally same-origin. A future external frame can still use load + paint.
    }

    if (frameDocument?.fonts) {
      await withTimeout(frameDocument.fonts.ready, 1_500);
    }

    if (frameDocument && expectsDarkReader && !documentUsesDarkReader(frameDocument)) {
      await waitForDarkReader(frameDocument, 500);
    }

    await waitForPaint();
  }

  function waitForDarkReader(frameDocument: Document, timeout: number) {
    if (documentUsesDarkReader(frameDocument)) return Promise.resolve();

    return new Promise<void>((resolve) => {
      const root = frameDocument.documentElement;
      let timeoutId = 0;
      const observer = new MutationObserver(() => {
        if (documentUsesDarkReader(frameDocument)) finish();
      });

      const finish = () => {
        window.clearTimeout(timeoutId);
        observer.disconnect();
        resolve();
      };

      timeoutId = window.setTimeout(finish, timeout);
      observer.observe(root, {
        attributes: true,
        attributeFilter: ['data-darkreader-mode'],
      });
    });
  }

  function documentUsesDarkReader(frameDocument: Document) {
    return frameDocument.documentElement.hasAttribute('data-darkreader-mode');
  }

  function frameUsesDarkReader(frame: HTMLIFrameElement) {
    try {
      return Boolean(frame.contentDocument && documentUsesDarkReader(frame.contentDocument));
    } catch {
      return false;
    }
  }

  function frameHasLoadedDatasetUrl(frame: HTMLIFrameElement) {
    const artifactUrl = frame.dataset.artifactUrl;
    return Boolean(
      artifactUrl && frameHasLoadedUrl(frame, new URL(artifactUrl, window.location.href).href),
    );
  }

  function frameHasLoadedUrl(frame: HTMLIFrameElement, expectedUrl: string) {
    try {
      return (
        frame.contentDocument?.readyState === 'complete' &&
        frame.contentWindow?.location.href === expectedUrl
      );
    } catch {
      return frame.src === expectedUrl;
    }
  }

  function withTimeout<T>(promise: Promise<T>, timeout: number) {
    return Promise.race([
      promise,
      new Promise<void>((resolve) => window.setTimeout(resolve, timeout)),
    ]);
  }

  function waitForPaint() {
    return new Promise<void>((resolve) => {
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => resolve()));
    });
  }

  function artifactRouteFromLink(link: HTMLAnchorElement) {
    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin || !url.pathname.startsWith(artifactRootPath)) return null;
    try {
      return decodeURIComponent(url.pathname.slice(artifactRootPath.length));
    } catch {
      return null;
    }
  }

  function frameMatches(
    frame: HTMLIFrameElement,
    artifact: Artifact,
    selection: ArtifactSelection,
  ) {
    return (
      frame.dataset.artifactRoute === artifact.route &&
      frame.dataset.artifactRevision === artifact.revision &&
      frame.dataset.artifactLocation === artifactLocation(selection)
    );
  }

  function frameCanApplyFragment(
    frame: HTMLIFrameElement,
    artifact: Artifact,
    selection: ArtifactSelection,
  ) {
    try {
      return (
        frame.dataset.artifactRoute === artifact.route &&
        frame.dataset.artifactRevision === artifact.revision &&
        frame.dataset.artifactQuery === selection.query &&
        frame.contentDocument?.querySelector<HTMLElement>('.markdown-document')
          ?.dataset.docshelfLineLinks === 'true'
      );
    } catch {
      return false;
    }
  }

  function applyLineSelectionToFrame(
    frame: HTMLIFrameElement,
    selection: ArtifactSelection,
  ) {
    frame.contentWindow?.postMessage(
      {
        type: 'docshelf-apply-line-selection',
        hash: selection.hash,
        scroll: true,
      },
      window.location.origin,
    );
  }

  function artifactFrameUrl(artifact: Artifact, selection: ArtifactSelection) {
    const url = new URL(`${artifactRootPath}${artifact.route}`, window.location.href);
    url.search = selection.query ? `?${selection.query}` : '';
    url.searchParams.set(revisionParameter, artifact.revision);
    url.hash = selection.hash;
    return `${url.pathname}${url.search}${url.hash}`;
  }

  function artifactViewerUrl(selection: ArtifactSelection) {
    const url = new URL(basePath, window.location.href);
    url.searchParams.set('artifact', selection.route);
    if (selection.query) url.searchParams.set('artifact-query', selection.query);
    url.hash = selection.hash;
    return `${url.pathname}${url.search}${url.hash}`;
  }

  function requestedSelection(): ArtifactSelection | null {
    const url = new URL(window.location.href);
    const route = url.searchParams.get('artifact');
    if (!route) return null;
    return normalizeSelection({
      route,
      query: url.searchParams.get('artifact-query') || '',
      hash: url.hash,
    });
  }

  function emptySelection(route: string): ArtifactSelection {
    return { route, query: '', hash: '' };
  }

  function normalizeSelection(selection: ArtifactSelection): ArtifactSelection {
    const hash = selection.hash && !selection.hash.startsWith('#')
      ? `#${selection.hash}`
      : selection.hash;
    return {
      route: selection.route,
      query: selection.query.replace(/^\?/, ''),
      hash,
    };
  }

  function artifactLocation(selection: ArtifactSelection) {
    return `${selection.query ? `?${selection.query}` : ''}${selection.hash}`;
  }

  function selectionKey(selection: ArtifactSelection | null | undefined) {
    return selection
      ? `${selection.route}\n${selection.query}\n${selection.hash}`
      : '';
  }

  function validRevisionState(state: RevisionState) {
    return (
      state?.version === 1 &&
      typeof state.catalogRevision === 'string' &&
      Array.isArray(state.artifacts) &&
      state.artifacts.every(
        (artifact) =>
          typeof artifact?.route === 'string' &&
          typeof artifact.revision === 'string' &&
          /^[a-f\d]{64}$/.test(artifact.revision),
      )
    );
  }

  function validBuildStatus(status: BuildStatus) {
    return (
      status?.version === 1 &&
      ['starting', 'building', 'ready', 'failed'].includes(status.state) &&
      (status.error === null ||
        (typeof status.error?.message === 'string' &&
          (status.error.details === null || typeof status.error.details === 'string')))
    );
  }
</script>

<style>
  :global(html:has(.docshelf-viewer) .sl-container) {
    max-width: none;
  }

  :global(html:has(.docshelf-viewer)) {
    --docshelf-artifact-background: #1a1b26;
    --docshelf-navigation-background: var(--docshelf-artifact-background);
    --sl-nav-height: 3rem;
    --sl-nav-pad-y: 0.25rem;
    --sl-mobile-toc-height: 0rem;
    background: var(--docshelf-artifact-background);
  }

  @media (min-width: 50rem) {
    :global(html:has(.docshelf-viewer)) {
      --sl-nav-height: 3.5rem;
      --sl-nav-pad-y: 0.5rem;
    }
  }

