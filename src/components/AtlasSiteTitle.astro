---
import StarlightSiteTitle from '@astrojs/starlight/components/SiteTitle.astro';

const showSidebarToggle = ['/', '/index.html'].includes(Astro.url.pathname);
---

<div class="atlas-site-title">
  {
    showSidebarToggle && (
      <button
        class="sidebar-toggle print:hidden"
        type="button"
        data-atlas-sidebar-toggle
        aria-controls="starlight__sidebar"
        aria-expanded="true"
        aria-label="Hide navigation"
        title="Toggle navigation (⌘B or Ctrl+B)"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <path d="M9 4v16" />
        </svg>
      </button>
    )
  }
  <StarlightSiteTitle />
</div>

<script>
  const sidebarToggle = document.querySelector<HTMLButtonElement>('[data-atlas-sidebar-toggle]');

  if (sidebarToggle && sidebarToggle.dataset.initialized !== 'true') {
    sidebarToggle.dataset.initialized = 'true';
    initializeSidebarToggle(sidebarToggle);
  }

  function initializeSidebarToggle(button: HTMLButtonElement) {
    const root = document.documentElement;

    button.addEventListener('click', () => {
      setSidebar(root.dataset.atlasLeft === 'hidden');
    });

    window.addEventListener('keydown', (event) => {
      if (
        isEditableTarget(event.target) ||
        !(event.metaKey || event.ctrlKey) ||
        event.altKey ||
        event.shiftKey ||
        event.key.toLowerCase() !== 'b' ||
        !window.matchMedia('(min-width: 50rem)').matches
      ) {
        return;
      }

      event.preventDefault();
      setSidebar(root.dataset.atlasLeft === 'hidden');
    });

    setSidebar(readPreference('atlas:left-panel') !== 'hidden', false);

    function setSidebar(visible: boolean, persist = true) {
      root.dataset.atlasLeft = visible ? 'visible' : 'hidden';
      button.setAttribute('aria-expanded', String(visible));
      button.setAttribute('aria-label', visible ? 'Hide navigation' : 'Show navigation');
      if (persist) writePreference('atlas:left-panel', visible ? 'visible' : 'hidden');
    }
  }

  function isEditableTarget(target: EventTarget | null) {
    return (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      (target instanceof HTMLElement && target.isContentEditable)
    );
  }

  function readPreference(key: string) {
    try {
      return window.localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function writePreference(key: string, value: string) {
    try {
      window.localStorage.setItem(key, value);
    } catch {
      // The navigation remains usable when storage is unavailable.
    }
  }
</script>

<style>
  .atlas-site-title {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.375rem;
  }

  .sidebar-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .sidebar-toggle:hover {
    border-color: var(--sl-color-hairline-light);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
  }

  .sidebar-toggle:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .sidebar-toggle[aria-expanded='false'] {
    color: var(--sl-color-gray-4);
  }

  .sidebar-toggle svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 50rem) {
    .sidebar-toggle {
      display: inline-flex;
    }

    :global(html[data-atlas-left='hidden']) {
      --sl-content-inline-start: 0rem;
    }

    :global(html[data-atlas-left='hidden'] nav.sidebar) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-toggle {
      transition: none;
    }
  }
</style>
